{
	"name": "@ateliercartographie/proj-suggest",
	"version": "0.0.1",
	"description": "Suggest map projections based on a bounding box, including national projections",
	"license": "ISC",
	"author": "Thomas Ansart — Atelier de cartographie de Sciences Po (https://www.sciencespo.fr/cartographie/)",
	"homepage": "https://github.com/AtelierCartographie/proj-suggest#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AtelierCartographie/proj-suggest.git"
	},
	"bugs": {
		"url": "https://github.com/AtelierCartographie/proj-suggest/issues"
	},
	"keywords": [
		"projection",
		"map",
		"cartography",
		"bbox",
		"proj4",
		"gis"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"prepare": "tsc",
		"build": "tsc && publint",
		"prepublishOnly": "npm run build",
		"check": "tsc --noEmit",
		"test": "vitest",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"prettier": "^3.8.1",
		"publint": "^0.3.18",
		"typescript": "^5.9.3",
		"vitest": "^4.1.0"
	}
}
