{
	"name": "proj-suggest",
	"version": "0.0.1",
	"description": "Suggest map projections based on a bounding box, including national projections",
	"license": "ISC",
	"keywords": [
		"projection",
		"map",
		"cartography",
		"bbox",
		"proj4",
		"gis"
	],
	"scripts": {
		"build": "tsc && publint",
		"prepublishOnly": "npm run build",
		"check": "tsc --noEmit",
		"test": "vitest",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"devDependencies": {
		"prettier": "^3.8.1",
		"publint": "^0.3.18",
		"typescript": "^5.9.3",
		"vitest": "^4.1.0"
	},
	"types": "./dist/index.d.ts",
	"type": "module"
}
